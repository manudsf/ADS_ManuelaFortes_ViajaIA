# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/viajaia

# Autenticação
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Agente de IA (Google Gemini)
GEMINI_API_KEY=

# Login com Google: o mesmo Client ID usado no frontend (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=

# E-mail (convites, notificações e recuperação de senha)
SMTP_HOST=
SMTP_PORT=2525
EMAIL_FROM=ViajaIA <nao-responda@viajaia.app>

# URL pública do frontend (usada nos links de e-mail)
APP_URL=http://localhost:5173
